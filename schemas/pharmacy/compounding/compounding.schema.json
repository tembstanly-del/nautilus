{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nautilus.example.com/schemas/pharmacy/compounding/compounding.schema.json",
  "title": "Pharmaceutical Compounding Schema",
  "description": "Schema for pharmaceutical compounding processes based on principles from 'Pharmaceutical Compounding and Dispensing' by John F. Marriott",
  "type": "object",
  "required": ["compoundingId", "prescriptionDetails", "formulation", "preparationMethod", "qualityControl", "labeling"],
  "properties": {
    "compoundingId": {
      "type": "string",
      "description": "Unique identifier for the compounding record",
      "pattern": "^COMP-[0-9]{8}$"
    },
    "prescriptionDetails": {
      "type": "object",
      "required": ["prescriptionNumber", "prescriber", "patient", "dateReceived"],
      "properties": {
        "prescriptionNumber": {
          "type": "string",
          "description": "Unique prescription identifier"
        },
        "prescriber": {
          "type": "object",
          "required": ["name", "license"],
          "properties": {
            "name": {
              "type": "string"
            },
            "license": {
              "type": "string"
            },
            "contact": {
              "type": "string"
            }
          }
        },
        "patient": {
          "type": "object",
          "required": ["name", "dateOfBirth"],
          "properties": {
            "name": {
              "type": "string"
            },
            "dateOfBirth": {
              "type": "string",
              "format": "date"
            },
            "patientId": {
              "type": "string"
            },
            "allergies": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "dateReceived": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "formulation": {
      "type": "object",
      "required": ["dosageForm", "ingredients", "totalQuantity"],
      "properties": {
        "dosageForm": {
          "type": "string",
          "enum": [
            "solution",
            "suspension",
            "emulsion",
            "cream",
            "ointment",
            "gel",
            "paste",
            "powder",
            "capsule",
            "tablet",
            "suppository",
            "pessary",
            "lozenge",
            "transdermalPatch"
          ],
          "description": "Type of pharmaceutical dosage form"
        },
        "ingredients": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/ingredient"
          }
        },
        "totalQuantity": {
          "type": "object",
          "required": ["value", "unit"],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "type": "string",
              "enum": ["g", "mg", "kg", "mL", "L", "units", "capsules", "tablets"]
            }
          }
        },
        "strength": {
          "type": "string",
          "description": "Concentration or strength of active ingredient(s)"
        },
        "beyondUseDate": {
          "type": "string",
          "format": "date",
          "description": "Date beyond which the preparation should not be used"
        }
      }
    },
    "preparationMethod": {
      "type": "object",
      "required": ["steps", "equipment", "environment"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["stepNumber", "description"],
            "properties": {
              "stepNumber": {
                "type": "integer",
                "minimum": 1
              },
              "description": {
                "type": "string"
              },
              "duration": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number"
                  },
                  "unit": {
                    "type": "string",
                    "enum": ["seconds", "minutes", "hours"]
                  }
                }
              },
              "temperature": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number"
                  },
                  "unit": {
                    "type": "string",
                    "enum": ["celsius", "fahrenheit"]
                  }
                }
              },
              "criticalControlPoint": {
                "type": "boolean",
                "description": "Indicates if this step is a critical control point"
              }
            }
          }
        },
        "equipment": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/equipment"
          }
        },
        "environment": {
          "type": "object",
          "required": ["cleanroomClass"],
          "properties": {
            "cleanroomClass": {
              "type": "string",
              "enum": ["ISO 5", "ISO 7", "ISO 8", "general"],
              "description": "Cleanroom classification for compounding area"
            },
            "laminarFlowHood": {
              "type": "boolean"
            },
            "biologicalSafetyCabinet": {
              "type": "boolean"
            }
          }
        },
        "technique": {
          "type": "string",
          "enum": [
            "geometric-dilution",
            "trituration",
            "levigation",
            "comminution",
            "sieving",
            "granulation",
            "encapsulation",
            "mixing",
            "homogenization",
            "emulsification",
            "incorporation"
          ]
        }
      }
    },
    "calculations": {
      "type": "object",
      "description": "Pharmaceutical calculations performed for this compounding",
      "properties": {
        "dosageCalculations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "calculation": {
                "type": "string"
              },
              "result": {
                "type": "string"
              },
              "verifiedBy": {
                "type": "string"
              }
            }
          }
        },
        "dilutionFactor": {
          "type": "number"
        },
        "concentrationCalculations": {
          "type": "string"
        }
      }
    },
    "qualityControl": {
      "type": "object",
      "required": ["visualInspection", "weighingVerification"],
      "properties": {
        "visualInspection": {
          "type": "object",
          "required": ["passed", "inspectedBy", "date"],
          "properties": {
            "passed": {
              "type": "boolean"
            },
            "appearance": {
              "type": "string"
            },
            "color": {
              "type": "string"
            },
            "homogeneity": {
              "type": "string",
              "enum": ["homogeneous", "heterogeneous", "layered"]
            },
            "inspectedBy": {
              "type": "string"
            },
            "date": {
              "type": "string",
              "format": "date-time"
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "weighingVerification": {
          "type": "object",
          "required": ["verifiedBy", "date"],
          "properties": {
            "verifiedBy": {
              "type": "string"
            },
            "date": {
              "type": "string",
              "format": "date-time"
            },
            "balanceId": {
              "type": "string"
            },
            "balanceCalibrationDate": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "phTesting": {
          "type": "object",
          "properties": {
            "measured": {
              "type": "number",
              "minimum": 0,
              "maximum": 14
            },
            "target": {
              "type": "number",
              "minimum": 0,
              "maximum": 14
            },
            "withinRange": {
              "type": "boolean"
            }
          }
        },
        "sterilityConcerns": {
          "type": "object",
          "properties": {
            "sterileProduct": {
              "type": "boolean"
            },
            "sterilizationMethod": {
              "type": "string",
              "enum": ["autoclaving", "filtration", "aseptic-technique", "none"]
            },
            "endotoxinTesting": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "labeling": {
      "type": "object",
      "required": ["patientName", "prescriptionNumber", "directions", "dateCompounded", "beyondUseDate", "compoundedBy"],
      "properties": {
        "patientName": {
          "type": "string"
        },
        "prescriptionNumber": {
          "type": "string"
        },
        "directions": {
          "type": "string",
          "description": "Instructions for use"
        },
        "dateCompounded": {
          "type": "string",
          "format": "date"
        },
        "beyondUseDate": {
          "type": "string",
          "format": "date"
        },
        "compoundedBy": {
          "type": "string",
          "description": "Pharmacist who compounded the preparation"
        },
        "storage": {
          "type": "string",
          "description": "Storage conditions"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "auxiliaryLabels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "documentation": {
      "type": "object",
      "properties": {
        "masterFormula": {
          "type": "string",
          "description": "Reference to master formulation record"
        },
        "batchNumber": {
          "type": "string"
        },
        "compoundingLog": {
          "type": "string",
          "description": "Reference to detailed compounding log"
        },
        "adverseEventReporting": {
          "type": "string"
        }
      }
    },
    "safety": {
      "type": "object",
      "properties": {
        "hazardousSubstances": {
          "type": "boolean"
        },
        "ppe": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["gloves", "gown", "mask", "eye-protection", "respirator", "shoe-covers"]
          },
          "description": "Personal protective equipment required"
        },
        "specialHandling": {
          "type": "string"
        }
      }
    },
    "dispensing": {
      "type": "object",
      "properties": {
        "dispensedBy": {
          "type": "string"
        },
        "dispensedDate": {
          "type": "string",
          "format": "date-time"
        },
        "counselingProvided": {
          "type": "boolean"
        },
        "counselingNotes": {
          "type": "string"
        },
        "container": {
          "type": "string",
          "enum": ["amber-bottle", "clear-bottle", "plastic-vial", "tube", "jar", "syringe", "bag"]
        }
      }
    }
  },
  "definitions": {
    "ingredient": {
      "type": "object",
      "required": ["name", "quantity", "role"],
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": ["active", "excipient", "preservative", "stabilizer", "antioxidant", "vehicle", "base", "emulsifier", "suspending-agent", "flavoring", "coloring"]
        },
        "quantity": {
          "type": "object",
          "required": ["value", "unit"],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "type": "string",
              "enum": ["g", "mg", "mcg", "kg", "mL", "L", "units", "drops", "percent"]
            }
          }
        },
        "lotNumber": {
          "type": "string"
        },
        "expirationDate": {
          "type": "string",
          "format": "date"
        },
        "supplier": {
          "type": "string"
        },
        "grade": {
          "type": "string",
          "enum": ["USP", "NF", "BP", "EP", "JP", "food-grade", "technical"]
        }
      }
    },
    "equipment": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "balance",
            "mortar-and-pestle",
            "spatula",
            "beaker",
            "graduated-cylinder",
            "stirring-rod",
            "hot-plate",
            "mixer",
            "capsule-machine",
            "sieve",
            "filter",
            "ointment-slab",
            "suppository-mold"
          ]
        },
        "equipmentId": {
          "type": "string"
        },
        "calibrationDate": {
          "type": "string",
          "format": "date"
        },
        "cleaned": {
          "type": "boolean"
        }
      }
    }
  }
}
